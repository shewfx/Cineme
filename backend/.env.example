# Copy to backend/.env (ignored by git). Placeholders only; never commit real values.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local PostgreSQL from infra/compose.yaml (password = POSTGRES_PASSWORD in infra/.env).
DATABASE_URL=postgresql+psycopg://cineme:<local-password>@127.0.0.1:5432/cineme
# Optional separate migration role; defaults to DATABASE_URL.
# DATABASE_MIGRATION_URL=

# Supabase Auth dev project (Project Settings > API). The publishable key is public;
# never put a secret/service-role key here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<placeholder>
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# TMDB v4 "API Read Access Token" (themoviedb.org > Settings > API). Backend only.
TMDB_READ_ACCESS_TOKEN=<tmdb-read-access-token>

# Integration tests: admin URL used to create and drop throwaway databases.
TEST_DATABASE_URL=postgresql+psycopg://cineme:<local-password>@127.0.0.1:5432/postgres
